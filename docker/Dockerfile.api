# FastAPI backend + RAG core (PyMuPDF, Tesseract OCR, Qdrant client, BM25 sparse model).
# Build context: source_code/   (see docker/docker-compose.yml)

FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FASTEMBED_CACHE_PATH=/opt/fastembed

# Tesseract for image-only pages (the flowchart on page 14)
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

# Bake the BM25 sparse model into the image so the container works offline
RUN python -c "from fastembed import SparseTextEmbedding; SparseTextEmbedding('Qdrant/bm25')"

COPY config.yaml ./
COPY rag ./rag
COPY api ./api

RUN useradd --create-home --uid 1000 app \
 && mkdir -p /app/data/documents /app/data/extracted \
 && chown -R app:app /app /opt/fastembed
USER app

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=300s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"

# Build (or verify) the index, then serve. Indexing is skipped when the corpus hash is unchanged.
CMD ["sh", "-c", "python -m rag.cli index && exec uvicorn api.main:app --host 0.0.0.0 --port 8000"]
