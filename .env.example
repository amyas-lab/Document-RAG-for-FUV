# Copy to .env and adjust. Every key in source_code/config.yaml can be overridden here (UPPER_CASE).
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://127.0.0.1:11434
# Leave empty for embedded Qdrant (local dev); Docker sets http://qdrant:6333
QDRANT_URL=
PDF_PARSER=pymupdf
CHUNKING=structure
TOP_K=5
PROMPT_MODE=strict
